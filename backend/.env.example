# Copy to .env for local runs. On Render, set these under Environment.

# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM: pick one provider: gemini | cerebras | mistral
LLM_PROVIDER=gemini
LLM_API_KEY=your-key
# Optional: override the default model for that provider
LLM_MODEL=

# The Vercel URL of the screen (comma-separate several). Use * only for local testing.
FRONTEND_ORIGIN=http://localhost:5173

PORT=8080
